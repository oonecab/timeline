# Environment variable reference; Timeline does not load this file automatically.
# Set TIMELINE_DB in your shell or MCP client. Prefer an absolute path.
# Empty or unset uses the default: <user-directory>/.timeline.json.
TIMELINE_DB=

# OS-provided variables are documented only; do not overwrite their values.
# Windows uses USERPROFILE, falling back to HOME when USERPROFILE is absent.
# USERPROFILE=
# Linux and macOS use HOME.
# HOME=
# Shell examples and platform paths: docs/environments.md.
